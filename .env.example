# Copia este archivo a `.env` y rellena los valores.
# NUNCA commitees `.env`: contiene credenciales de Supabase.

# URL base del proyecto Supabase (Panel > Settings > API > Project URL)
SUPABASE_URL=https://your-project-ref.supabase.co

# Clave anon pública (Panel > Settings > API) — seguridad: solo roles permitidos por RLS
SUPABASE_KEY=your-anon-key

# Cadena de conexión de Postgres (Panel > Connect > Connection string).
# Preferir el pooler de transacción (puerto 6543) para la app.
DATABASE_URL=postgresql://postgres.your-project-ref:YOUR-PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

# Orígenes permitidos por CORS (separados por coma)
CORS_ORIGINS=http://localhost:3000