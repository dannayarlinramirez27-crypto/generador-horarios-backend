# Copia este archivo a `.env` y rellena los valores.
# NUNCA commitees `.env`: contiene credenciales de Supabase.

# URL base del proyecto Supabase (Panel > Settings > API > Project URL)
SUPABASE_URL=https://your-project-ref.supabase.co

# Clave anon pública (Panel > Settings > API) — seguridad: solo roles permitidos por RLS
SUPABASE_KEY=your-anon-key

# Cadena de conexión de Postgres (Panel > Connect > Connection string).
# Usar el puerto directo 5432 para evitar errores con prepared statements.
DATABASE_URL=postgresql://postgres.your-project-ref:YOUR-PASSWORD@db.your-project-ref.supabase.co:5432/postgres?sslmode=require

# Orígenes permitidos por CORS (separados por coma).
# Añade aquí el dominio de producción del frontend en Vercel.
CORS_ORIGINS=http://localhost:3000,https://horarios-frontend.vercel.app

# (Opcional) Patrón regex para orígenes dinámicos (ej. previews de Vercel).
# Vacío = desactivado. Habilita todos los subdominios de Vercel:
CORS_ORIGIN_REGEX=https://.*\.vercel\.app